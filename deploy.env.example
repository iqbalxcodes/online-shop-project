# Salin file ini menjadi deploy.env lalu isi.  (deploy.env tidak ikut ke GitHub)
# JANGAN taruh password MongoDB atau JWT_SECRET di sini; itu tempatnya di Render.

# URL backend di Render dan web di Vercel (tanpa "/" di akhir)
API_URL=https://online-shop-project-gfe0.onrender.com
WEB_URL=https://online-shop-project-chi.vercel.app

# Branch yang dipantau Render dan Vercel
DEPLOY_BRANCH=main

# Opsional: Render > service backend > Settings > Deploy Hook.
# Isi kalau Auto-Deploy di Render dimatikan.
RENDER_DEPLOY_HOOK_URL=

# git = Vercel auto-deploy dari GitHub (default)
# cli = deploy lewat Vercel CLI (perlu bash deploy.sh --setup sekali)
WEB_DEPLOY_MODE=git

# Branch EAS Update untuk aplikasi mobile
EAS_BRANCH=production

# Batas waktu menunggu Render/Vercel selesai deploy (detik)
WAIT_TIMEOUT=900

# Lokasi folder (biarkan kalau struktur repo tidak diubah)
SERVER_DIR=server
WEB_DIR=client/my-app
MOBILE_DIR=online-shop-mobile
